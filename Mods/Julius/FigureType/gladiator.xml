<?xml version="1.0" encoding="utf-8"?>
<figure type="gladiator">
    <profiles default="venue_seeker">
        <profile id="venue_seeker">
            <native class="entertainment_venue_seeker" />
            <owner slot="primary" building="gladiator_school" state="in_use" />
            <movement roam_ticks="1" max_roam_length="3200" return_mode="none" />
            <pathing mode="venue_seeker" terrain="roads" />
            <venue_targets show_duration="32">
                <venue building="amphitheater" show_slot="days1" />
                <venue building="colosseum" show_slot="days2" />
            </venue_targets>
        </profile>
        <profile id="amphitheater_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="amphitheater" state="in_use" />
            <movement roam_ticks="1" max_roam_length="512" return_mode="return_to_owner_road" />
            <pathing mode="vanilla_roaming" terrain="roads" effect="entertainment_amphitheater_gladiator" />
        </profile>
        <profile id="colosseum_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="colosseum" state="in_use" />
            <movement roam_ticks="1" max_roam_length="512" return_mode="return_to_owner_road" />
            <pathing mode="vanilla_roaming" terrain="roads" effect="entertainment_colosseum_gladiator" />
        </profile>
    </profiles>
    <graphics>
        <default max_image_offset="12">
            <path value="Warriors\Group_111" />
            <image value="move_{dir}" />
        </default>
        <action state="attack" frame_count="16">
            <path value="Warriors\Group_111" />
            <image value="attack_{dir}" />
        </action>
        <corpse>
            <path value="Warriors\Group_111" />
            <image value="corpse" />
        </corpse>
    </graphics>
</figure>
