<?xml version="1.0" encoding="utf-8"?>
<window id="empire_details" base_width="640" base_height="120">
    <!-- The map frame already supplies the original tiled background. -->
    <widget id="right_eagle" type="image" assetlist="PaperMap\Empire_Panels" image="Image_0007" visible_binding="sidebar.collapsed" x="554" y="-79" width="84" height="120" anchor_x="far"/>
    <widget id="left_eagle" type="image" assetlist="PaperMap\Empire_Panels" image="Image_0006" x="2" y="-79" width="84" height="120"/>
    <widget id="city_badge" type="image" assetlist="PaperMap\Empire_Panels" image="Image_0008" x="154" y="-61" width="332" height="92" anchor_x="center"/>
    <widget id="city_name" type="label" binding="selected.name" visible_binding="selected.city" x="218" y="2" width="268" height="24" anchor_x="center" font="large_black" text_alignment="center"/>
    <widget id="sells" type="custom" binding="trade.sells" visible_binding="selected.open_trade" x="114" y="38" width="444" height="26" anchor_x="center" font="normal_green" padding_x="15" text_offset_y="9"/>
    <widget id="buys" type="custom" binding="trade.buys" visible_binding="selected.open_trade" x="114" y="69" width="444" height="26" anchor_x="center" font="normal_green" padding_x="15" text_offset_y="9"/>
    <widget id="closed_resources" type="custom" binding="trade.closed" visible_binding="selected.closed" x="120" y="40" width="430" height="26" anchor_x="center" font="normal_green" padding_x="10" padding_y="15" text_offset_y="9"/>
    <widget id="open" type="custom" binding="trade.open" visible_binding="selected.closed" x="100" y="63" width="440" height="26" anchor_x="center" font="normal_green" padding_x="10" text_offset_y="10"/>
    <widget id="selected_info" type="rich_text" binding="selected.info" x="200" y="52" width="240" height="48" anchor_x="center" font="normal_green"/>
    <widget id="help" type="image_button" action="help" assetlist="UI\Context_Icons" image="Image_0000" pressed_image="Image_0002" x="20" y="76" width="27" height="27"/>
    <widget id="prices" type="image_button" action="prices" assetlist="UI\Message_Advisor_Buttons" image="Image_0030" pressed_image="Image_0032" x="20" y="20" width="24" height="24"/>
    <widget id="advisor" type="image_button" action="advisor" assetlist="UI\Message_Advisor_Buttons" image="Image_0012" pressed_image="Image_0014" x="592" y="20" width="24" height="24" anchor_x="far"/>
    <widget id="close" type="image_button" action="close" assetlist="UI\Context_Icons" image="Image_0004" pressed_image="Image_0006" x="596" y="76" width="24" height="24" anchor_x="far"/>
</window>