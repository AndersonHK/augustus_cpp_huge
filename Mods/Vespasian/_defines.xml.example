<?xml version="1.0" encoding="utf-8"?>
<defines>
    <!-- Every direct child is optional in a derived mod. Delete blocks that
         should inherit from an earlier layer. Values shown here reproduce the
         current Vespasian definitions. -->

    <calendar id="default" ticks_per_day="100">
        <!-- Exactly 12 positive integers, January through December. -->
        <month_days values="31,28,31,30,31,30,31,31,30,31,30,31" />
    </calendar>

    <combat default_building_hit_points="20" />
    <presentation legacy_figure_logical_units_per_source_pixel="96" />

    <birth_table id="default">
        <!-- Exactly 10 non-negative integers for ages 0-9 through 90-99. -->
        <age_decennia values="0,3,16,9,2,0,0,0,0,0" />
    </birth_table>

    <mortality_table id="default">
        <!-- All 11 health buckets are required when this table is authored.
             Each row has 10 non-negative values for the same age decennia. -->
        <health bucket="0" values="20,10,5,10,20,30,50,85,100,100" />
        <health bucket="1" values="15,8,4,8,16,25,45,70,90,100" />
        <health bucket="2" values="10,6,2,6,12,20,30,55,80,90" />
        <health bucket="3" values="5,4,0,4,8,15,25,40,65,80" />
        <health bucket="4" values="3,2,0,2,6,12,20,30,50,70" />
        <health bucket="5" values="2,0,0,0,4,8,15,25,40,60" />
        <health bucket="6" values="1,0,0,0,2,6,12,20,30,50" />
        <health bucket="7" values="0,0,0,0,0,4,8,15,20,40" />
        <health bucket="8" values="0,0,0,0,0,2,6,10,15,30" />
        <health bucket="9" values="0,0,0,0,0,0,4,5,10,20" />
        <health bucket="10" values="0,0,0,0,0,0,0,2,5,10" />
    </mortality_table>
</defines>
