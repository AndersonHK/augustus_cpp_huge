<?xml version="1.0" encoding="utf-8"?>
<figure type="barkeep">
    <profiles default="legacy">
        <profile id="legacy">
            <native class="legacy_action" />
            <owner slot="primary" building="any" state="in_use" />
            <movement terrain_usage="roads" roam_ticks="1" max_roam_length="576" return_mode="return_to_owner_road" />
            <pathing mode="vanilla_roaming" />
