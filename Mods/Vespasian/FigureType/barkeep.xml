    </profiles>
    <graphics
        path_pattern="Walkers\Barkeep_{dir_upper}_{frame}"
        image_pattern="Barkeep {dir_upper} {frame}"
        corpse_path_pattern="Walkers\Barkeep_death_{frame}"
        corpse_image_pattern="Barkeep death {frame}"
        max_image_offset="12" />
</figure>
