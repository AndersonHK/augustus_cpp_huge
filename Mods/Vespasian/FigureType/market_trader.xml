<?xml version="1.0" encoding="utf-8"?>
<figure type="market_trader">
    <profiles default="service">
        <profile id="service">
            <native class="roaming_service" />
            <owner slot="primary" building="market" state="in_use" />
            <movement roam_ticks="1" max_roam_length="576" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" terrain="roads" effect="market_goods" />
        </profile>
    </profiles>
    <graphics
        path_pattern="Walkers\marketbuyer_{dir}_{frame}"
        image_pattern="marketbuyer_{dir}_{frame}"
        corpse_path_pattern="Walkers\marketbuyer_death_{frame}"
        corpse_image_pattern="marketbuyer_death_{frame}"
        corpse_frame_count="5"
        max_image_offset="12" />
</figure>
