<?xml version="1.0" encoding="utf-8"?>
<figure type="engineer">
    <profiles default="service">
        <profile id="service">
            <native class="engineer_service" />
            <owner slot="primary" building="engineers_post" state="in_use" />
            <movement roam_ticks="1" max_roam_length="960" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" terrain="roads" effect="damage_risk" />
        </profile>
    </profiles>
    <graphics>
        <default max_image_offset="12">
            <path value="Walkers\Engineer" />
            <image value="move_{dir}" />
        </default>
        <corpse>
            <path value="Walkers\Engineer" />
            <image value="corpse" />
        </corpse>
    </graphics>
</figure>
