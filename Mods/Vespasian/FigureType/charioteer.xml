<?xml version="1.0" encoding="utf-8"?>
<figure type="charioteer">
    <profiles default="venue_seeker">
        <profile id="venue_seeker">
            <native class="entertainment_venue_seeker" />
            <owner slot="primary" building="any" state="in_use" />
            <movement roam_ticks="1" max_roam_length="4800" return_mode="none" />
            <pathing mode="venue_seeker" terrain="roads_highway" />
            <venue_targets show_duration="64">
                <venue building="hippodrome" show_slot="days1" />
            </venue_targets>
        </profile>
        <profile id="hippodrome_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="hippodrome" state="in_use" />
            <movement roam_ticks="1" max_roam_length="768" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" terrain="roads_highway" effect="entertainment_hippodrome" />
        </profile>
    </profiles>
    <graphics>
        <default max_image_offset="12">
            <path value="Walkers\Charioteer" />
            <image value="move_{dir}" />
        </default>
        <corpse frame_count="1">
            <path value="Walkers\Charioteer" />
            <image value="corpse" />
        </corpse>
    </graphics>
</figure>
