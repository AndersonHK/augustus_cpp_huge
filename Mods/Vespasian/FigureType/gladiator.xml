<?xml version="1.0" encoding="utf-8"?>
<figure type="gladiator">
    <profiles default="venue_seeker">
        <profile id="venue_seeker">
            <native class="entertainment_venue_seeker" />
            <owner slot="primary" building="gladiator_school" state="in_use" />
            <movement terrain_usage="roads" roam_ticks="1" max_roam_length="4800" return_mode="none" />
            <pathing mode="venue_seeker" />
            <venue_targets show_duration="64">
                <venue building="amphitheater" show_slot="days1" />
                <venue building="colosseum" show_slot="days2" />
                <venue building="arena" show_slot="days2" />
            </venue_targets>
        </profile>
        <profile id="amphitheater_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="amphitheater" state="in_use" />
            <movement terrain_usage="roads" roam_ticks="1" max_roam_length="768" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" effect="entertainment_amphitheater_gladiator" />
        </profile>
        <profile id="arena_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="arena" state="in_use" />
            <movement terrain_usage="roads" roam_ticks="1" max_roam_length="768" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" effect="entertainment_arena_gladiator" />
        </profile>
        <profile id="colosseum_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="colosseum" state="in_use" />
            <movement terrain_usage="roads" roam_ticks="1" max_roam_length="768" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" effect="entertainment_colosseum_gladiator" />
        </profile>
    </profiles>
    <graphics image_group="gladiator" max_image_offset="12" />
</figure>
