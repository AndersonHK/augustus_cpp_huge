<?xml version="1.0" encoding="utf-8"?>
<figure type="lion_tamer">
    <profiles default="venue_seeker">
        <profile id="venue_seeker">
            <native class="entertainment_venue_seeker" />
            <owner slot="primary" building="lion_house" state="in_use" />
            <movement roam_ticks="1" max_roam_length="4800" return_mode="none" />
            <pathing mode="venue_seeker" terrain="roads" />
            <venue_targets show_duration="64">
                <venue building="colosseum" show_slot="days1" />
                <venue building="arena" show_slot="days1" />
            </venue_targets>
        </profile>
        <profile id="arena_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="arena" state="in_use" />
            <movement roam_ticks="1" max_roam_length="768" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" terrain="roads" effect="entertainment_arena_lion" />
        </profile>
        <profile id="colosseum_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="colosseum" state="in_use" />
            <movement roam_ticks="1" max_roam_length="768" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" terrain="roads" effect="entertainment_colosseum_lion" />
        </profile>
    </profiles>
    <graphics image_group="lion_tamer" max_image_offset="12" />
</figure>
