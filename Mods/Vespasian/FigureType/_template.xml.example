<?xml version="1.0" encoding="utf-8"?>
<figure type="replace_with_supported_figure_attr">
    <profiles default="service">
        <profile id="service">
            <native class="roaming_service" />
            <owner slot="primary" building="any" state="in_use" />
            <movement roam_ticks="1" max_roam_length="384" return_mode="return_to_owner_road" />
            <pathing mode="vanilla_roaming" terrain="roads" />
        </profile>
    </profiles>
    <graphics>
        <default>
            <path value="Walkers\replace_with_group_or_file" />
        </default>
    </graphics>
</figure>
