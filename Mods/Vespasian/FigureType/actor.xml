<?xml version="1.0" encoding="utf-8"?>
<figure type="actor">
    <profiles default="venue_seeker">
        <profile id="venue_seeker">
            <native class="entertainment_venue_seeker" />
            <owner slot="primary" building="actor_colony" state="in_use" />
            <movement terrain_usage="roads" roam_ticks="1" max_roam_length="4800" return_mode="none" />
            <pathing mode="venue_seeker" />
            <venue_targets show_duration="32">
                <venue building="theater" show_slot="days1" />
                <venue building="amphitheater" show_slot="days2" />
            </venue_targets>
        </profile>
        <profile id="theater_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="theater" state="in_use" />
            <movement terrain_usage="roads" roam_ticks="1" max_roam_length="768" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" effect="entertainment_theater" />
        </profile>
        <profile id="amphitheater_service">
            <native class="entertainment_service" />
            <owner slot="primary" building="amphitheater" state="in_use" />
            <movement terrain_usage="roads" roam_ticks="1" max_roam_length="768" return_mode="return_to_owner_road" />
            <pathing mode="smart_service" effect="entertainment_amphitheater_actor" />
        </profile>
    </profiles>
    <graphics image_group="actor" max_image_offset="12" />
</figure>
