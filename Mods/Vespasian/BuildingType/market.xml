<?xml version="1.0" encoding="utf-8"?>
<building type="market">
    <identity name_key="building.market.name" />
    <model size="2" cost="40" />
    <desirability>
        <value value="-2" />
        <step value="1" />
        <step_size value="1" />
        <range value="6" />
    </desirability>
    <foundation policy="land" />
    <button group="industry" order="30" icon="Admin_Logistics\Market" text_key="building.market.name" />
    <sound id="market" />
    <event_data attr="market" />
    <graphics>
        <default>
            <path value="Admin_Logistics\Market" />
            <image value="Image_0000" />
        </default>
        <variant>
            <condition type="desirability" operator="gt" threshold="30" />
            <path value="Admin_Logistics\Market_Fancy" />
            <image value="Image_0000" />
        </variant>
    </graphics>
    <labor>
        <employees count="5" />
        <labor_seeker>
            <method value="workforce" />
        </labor_seeker>
    </labor>
</building>
