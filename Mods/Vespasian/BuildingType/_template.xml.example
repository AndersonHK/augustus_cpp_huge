<?xml version="1.0" encoding="utf-8"?>
<building type="replace_with_building_attr">
    <!-- Optional build-authority metadata -->
    <identity name_key="translation.key.for.localized.building.name" />
    <model size="2" cost="80" />
    <desirability>
        <value value="-3" />
        <step value="1" />
        <step_size value="1" />
        <range value="3" />
    </desirability>
    <foundation policy="land" />
    <button group="industry" order="100" icon="Industry\Example_Icon"
        text_key="translation.key.for.localized.building.name" />

    <!-- Optional rule-driven water access definition.
         Type ids resolve through Mods/<Mod>/WaterAccessType/*.xml. -->
    <water_access>
        <provides type="reservoir" range="10" origin="footprint" />
        <provides type="aqueduct" range="0" origin="nodes" />
        <requires mode="any">
            <source type="water_source_any" />
            <access type="aqueduct" where="nodes" />
        </requires>
        <node x="1" y="-1" />
        <node x="3" y="1" />
        <node x="1" y="3" />
        <node x="-1" y="1" />
    </water_access>

    <!-- Optional graphics definition -->
    <graphics>
        <default>
            <path value="Health_Culture\Example_Base" />
            <!-- Options inherit the target path unless an option provides its own path. -->
            <options selection="stable_variant">
                <option image="Image_0000" />
                <option path="Health_Culture\Example_Base_Alternate" image="Image_0000" />
            </options>
        </default>
        <variant>
            <condition type="desirability" operator="gt" threshold="50" />
            <condition type="has_workers" />
            <condition type="water_access" />
            <path value="Health_Culture\Example_Fancy_Working" />
        </variant>
        <variant>
            <condition type="has_workers" />
            <condition type="water_access" />
            <path value="Health_Culture\Example_Working" />
        </variant>
        <variant>
            <condition type="figure_slot_occupied" slot="quaternary" />
            <path value="Health_Culture\Example_Guarded" />
        </variant>
        <variant>
            <condition type="resource_positive" resource="wine" />
            <path value="Health_Culture\Example_Supplied" />
        </variant>
    </graphics>

    <!-- Optional labor definition -->
    <labor>
        <employees count="10" />
        <labor_seeker>
            <method value="houses_spawn_if_below" />
            <amount value="50" />
        </labor_seeker>
    </labor>

    <!-- Optional native storage/production references -->
    <storages>
        <storage path="example_storage" />
    </storages>
    <production_methods>
        <production_method path="example_production_method" />
    </production_methods>

    <!-- Optional native housing reference -->
    <housing path="example_housing_type" evolve_to="next_house_type" devolve_to="previous_house_type"
        merge_to="merged_house_type" split_to="split_house_type" />

    <!-- Optional shared-delay spawn group -->
    <spawn_group road_access="normal" delay_bands="100:3,75:7,50:15,25:29,1:44" existing_figure="librarian"
        guard_timing="before_road_access">
        <spawn mode="service_roamer" spawn_figure="librarian"
            action_state="roaming" direction="top" figure_slot="primary" spawn_count="1" init_roaming="true"
            graphic_timing="before_delay_check" require_water_access="false" mark_problem_if_no_water="false"
            condition="always" block_on_success="true" />
    </spawn_group>

    <!-- Metadata-only or graphics-only vertical slices may stop when live runtime ownership is deferred -->
</building>
