<?xml version="1.0" encoding="utf-8"?>
<building type="sand_pit">
    <identity name_key="building.sand_pit.name" />
    <model size="2" cost="40" />
    <desirability>
        <value value="-6" />
        <step value="1" />
        <step_size value="1" />
        <range value="4" />
    </desirability>
    <foundation policy="custom">
        <terrain value="distant_water" />
    </foundation>
    <button group="raw_materials" order="70" icon="Industry\Sand_Pit_C_OFF" text_key="building.sand_pit.name" />
    <event_data attr="sand_pit" />
    <graphics>
        <default>
            <path value="Industry\Sand_Pit_C_OFF" />
            <image value="Sand_Pit_C_OFF" />
        </default>
        <variant>
            <condition type="climate" value="desert" />
            <path value="Industry\Sand_Pit_C_OFF" />
            <image value="Sand_Pit_S_ON" />
        </variant>
        <variant>
            <condition type="climate" value="northern" />
            <path value="Industry\Sand_Pit_C_OFF" />
            <image value="Sand_Pit_N_ON" />
        </variant>
        <variant>
            <path value="Industry\Sand_Pit_C_OFF" />
            <image value="Sand_Pit_C_ON" />
        </variant>
    </graphics>
    <labor>
        <employees count="10" />
        <labor_seeker>
            <method value="workforce" />
        </labor_seeker>
    </labor>
    <storages>
        <storage path="sand_output_sand_pit" />
    </storages>
    <production_methods>
        <production_method path="sand_pit_basic" />
    </production_methods>
</building>
