<?xml version='1.0' encoding='utf-8'?>
<window id="empire_city_card" base_width="576" base_height="140">
    <widget id="panel" type="panel" style="inner_panel" phase="background" x="0" y="0" width="576" height="136" stretch_width="true" selected_binding="city.selected" />
    <widget id="badge" type="image_button" assetlist="UI\Empire_sidebar_city_badge" image="Empire_sidebar_city_badge" x="5" y="5" width="262" height="33" action="city.ledger" tooltip_binding="city.ledger" />
    <widget id="name" type="label" binding="city.name" x="12" y="9" width="246" height="24" font="large_black" ellipsize="true" text_alignment="center" />
    <widget id="route_type" type="image" binding="city.route_type" x="282" y="11" width="34" height="24" />
    <widget id="sells" type="custom" binding="trade.sells" visible_binding="city.open" x="10" y="57" width="550" height="26" stretch_width="true" font="normal_green" padding_x="25" text_offset_y="9" repeat_columns="2" />
    <widget id="buys" type="custom" binding="trade.buys" visible_binding="city.open" x="10" y="84" width="550" height="26" stretch_width="true" font="normal_green" padding_x="25" text_offset_y="9" repeat_columns="2" />
    <widget id="closed_resources" type="custom" binding="trade.closed" visible_binding="city.closed" x="10" y="52" width="550" height="26" stretch_width="true" font="normal_green" padding_x="25" padding_y="10" text_offset_y="9" repeat_columns="2" />
    <widget id="open" type="custom" binding="trade.open" visible_binding="city.closed" x="30" y="96" width="516" height="26" stretch_width="true" font="normal_green" padding_x="8" text_offset_y="9" />
</window>